# 复制为 .env 后按需修改；所有变量都有默认值，全部省略也能启动。
# 变量名大小写不敏感（pydantic-settings）。

# 运行环境标识：local / test / staging / prod
APP_ENV=local

# 应用版本，会出现在 GET /healthz 的 version 字段
APP_VERSION=1.0.0

# 数据库连接串
# 本地/测试：SQLite（自动使用 check_same_thread=False）
# 生产：postgresql+psycopg://exam:password@postgres:5432/exam
DATABASE_URL=sqlite:///./app.db

# 服务端会话有效期（小时），契约约定 8h
SESSION_TTL_HOURS=8

# 请求追踪头；客户端未提供时服务端生成 uuid4 并回写响应头
REQUEST_ID_HEADER=X-Request-ID

# 业务接口统一前缀（Nginx 反代 /api）
API_PREFIX=/api
