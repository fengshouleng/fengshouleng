# deploy/monitoring/monitoring.env.example — 监控脚本配置模板（TASK-REL-003）
#
# 用法：
#   cp deploy/monitoring/monitoring.env.example deploy/monitoring/monitoring.env
#   chmod 600 deploy/monitoring/monitoring.env
#   # 按需修改下面的值；monitoring.env 禁止提交版本库，禁止写入真实令牌
#
# 生效方式：脚本启动时 source 本文件（默认路径 deploy/monitoring/monitoring.env，
# 可用 MONITORING_ENV_FILE 指向别处；设为空串则完全禁用）。
# 优先级：monitoring.env > 进程环境变量 > 脚本内默认值。
# 因此临时覆盖文件里的值时请这样执行：
#   MONITORING_ENV_FILE= BASE_URL=http://127.0.0.1:18080 bash deploy/monitoring/health_probe.sh
#
# 安全：本文件只放“非机密”阈值与告警命令；webhook URL/令牌通过 export 的本文件变量
# 或 systemd EnvironmentFile/宿主 secret 注入，权限保持 600。

# ---------------------------------------------------------------------------
# 健康探测（health_probe.sh）
# ---------------------------------------------------------------------------
# 站点入口；staging 默认 8080，prod 换成 80/443（TLS 就绪后）
BASE_URL=http://127.0.0.1:8080
HEALTH_PATH=/api/healthz
NGINX_HEALTH_PATH=/nginx-health
PROBE_CONNECT_TIMEOUT=3
PROBE_MAX_TIME=5
# 连续失败多少次才告警（cron 每分钟一次 → 默认约 3 分钟）
HEALTH_FAIL_THRESHOLD=3
# 同一告警的钩子冷却（秒）；0 = 每次都通知（仅建议演练时使用）
HEALTH_ALERT_REPEAT_SECONDS=3600

# ---------------------------------------------------------------------------
# 资源与备份（resource_alerts.sh）
# ---------------------------------------------------------------------------
# 空格分隔多个路径；只检查挂载点使用率
DISK_PATHS="/"
# 超过该百分比告警（严格大于；85 表示 86% 起告警）
DISK_THRESHOLD_PCT=85
# auto|local|container|skip；local 需要 BACKUP_DIR 在宿主可读
FRESHNESS_MODE=auto
# local 模式的备份目录（通常需要把命名卷挂到宿主，或从 backup 容器导出）
# BACKUP_DIR=/opt/exam/backups
BACKUP_FRESHNESS_MAX_HOURS=26
# 容器状态检查（--skip-containers 可临时关闭）
EXPECTED_SERVICES="postgres api nginx backup"
CONTAINER_RESTART_WARN=5
# compose 定位（cron 下建议写绝对路径）
# COMPOSE_FILE=/opt/exam/deploy/docker-compose.yml
# ENV_FILE=/opt/exam/deploy/.env.staging
# COMPOSE_PROJECT_NAME=exam-staging

# ---------------------------------------------------------------------------
# 慢请求日报（slow_requests.sh）
# ---------------------------------------------------------------------------
SLOW_LATENCY_MS=1000
SLOW_TOP_N=10
SLOW_LOG_SINCE=24h

# ---------------------------------------------------------------------------
# 证据/状态目录（告警文件、health_probe.state、慢请求报告、自测证据）
# ---------------------------------------------------------------------------
# 生产建议用仓库内绝对路径，便于随发布记录归档；确保 cron 用户可写。
STATE_DIR=/opt/exam/deploy/evidence/monitoring

# ---------------------------------------------------------------------------
# 告警通道（ALERT_CMD）—— 默认只落告警文件，不对外发送
# ---------------------------------------------------------------------------
# 接口（见 deploy/monitoring/lib.sh）：
#   sh -c "$ALERT_CMD"，环境变量：
#     ALERT_REASON  health_probe_failed | disk_high | backup_stale | container_unhealthy
#     ALERT_MESSAGE 人类可读摘要（不含密码/令牌）
#     ALERT_FILE    告警落盘文件
#     ALERT_SOURCE  health_probe | resource_alerts | slow_requests
#
# 示例 1：企业微信/钉钉/Slack 通用 webhook（URL 从环境变量读，禁止写死在仓库）
# 注意：本文件被 source，ALERT_WEBHOOK_URL 必须 export，钩子子进程才能读到。
# export ALERT_WEBHOOK_URL=https://alert.example.invalid/hook/CHANGE_ME
# ALERT_CMD='curl -fsS -m 5 -H "Content-Type: application/json" -d "{\"text\":\"[$ALERT_SOURCE] $ALERT_REASON: $ALERT_MESSAGE\"}" "$ALERT_WEBHOOK_URL"'
#
# 示例 2：仅追加到宿主日志文件（无外网时的过渡方案）
# ALERT_CMD='printf "%s %s %s\n" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$ALERT_REASON" "$ALERT_MESSAGE" >> /var/log/exam-alerts.log'
#
# 示例 3：邮件（依赖宿主 mail 命令；服务器需已配置 MTA）
# ALERT_CMD='printf "%s\n" "$ALERT_MESSAGE" | mail -s "[exam][$ALERT_REASON] alert" ops@example.invalid'
#
# 留空/不设置 = 只写告警文件，由人工/其他采集器读取。
# 注意：取消下面这行的注释会清空 ALERT_CMD，务必放在所有 ALERT_CMD 配置之后。
# ALERT_CMD=
