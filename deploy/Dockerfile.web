# syntax=docker/dockerfile:1.7
# deploy/Dockerfile.web — 前端构建 + Nginx 运行镜像（TASK-REL-001 / ADR-008）
#
# 构建上下文 = 仓库根（compose: build.context: ..）：
#   - web/ 为 Vite 工程（pnpm build → dist/）
#   - deploy/nginx.conf 需要复制进 nginx 镜像
# 产出镜像只包含 nginx + dist 静态文件，不含 Node。
#
# 构建：docker compose -f deploy/docker-compose.yml build nginx

ARG NODE_VERSION=20.18.0
ARG NGINX_VERSION=1.27.2

# ---------------------------------------------------------------------------
# build：pnpm install → pnpm build（tsc --noEmit && vite build）
# ---------------------------------------------------------------------------
FROM node:${NODE_VERSION}-alpine3.20 AS build

ENV CI=true \
    NODE_ENV=development

WORKDIR /app

# 固定 pnpm 主版本，与 CI（.github/workflows/ci.yml `version: 9`）保持一致。
# 未固定 patch 版本：待 web/pnpm-lock.yaml（P-004）补齐后，改为 `pnpm@9.12.x` 精确锁定。
RUN npm install --global pnpm@9

# 整目录复制：仓库当前**没有** web/pnpm-lock.yaml（P-004），
# COPY web/pnpm-lock.yaml* 在文件缺失时会使构建失败，故不做精确 COPY。
COPY web/ ./

# P-004：锁文件存在时必须 frozen（可复现）；缺失时退回 --no-frozen-lockfile 并告警。
# 补齐 web/pnpm-lock.yaml 后本分支自然收窄为 frozen。
RUN if [ -f pnpm-lock.yaml ]; then \
        echo "[build] pnpm install --frozen-lockfile"; \
        pnpm install --frozen-lockfile; \
    else \
        echo "[build] WARN 缺少 web/pnpm-lock.yaml（P-004），退回 --no-frozen-lockfile" >&2; \
        pnpm install --no-frozen-lockfile; \
    fi \
    && pnpm build \
    && test -f dist/index.html

# ---------------------------------------------------------------------------
# runtime：nginx 托管 dist，配置见 deploy/nginx.conf
# ---------------------------------------------------------------------------
FROM nginx:${NGINX_VERSION}-alpine AS runtime

# 该文件是 http 上下文内的片段（upstream + server），不能包含 events{}/http{}
RUN rm -f /etc/nginx/conf.d/default.conf

COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

# 静态资源属主交给 nginx（worker 以 nginx 用户运行）；conf 保持 root 只读
RUN chown -R nginx:nginx /usr/share/nginx/html \
    && chmod -R a-w /etc/nginx/conf.d

EXPOSE 80

# 健康检查统一在 compose 层声明（/nginx-health，不经过 api）
