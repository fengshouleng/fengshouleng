# deploy/.env.example — 环境变量模板（TASK-REL-001）
#
# 用法：
#   cp deploy/.env.example deploy/.env.staging   # 然后填写占位值
#   docker compose --env-file deploy/.env.staging -p exam-staging config -q
#
# 规则（必须遵守）：
#   1. 本文件只允许占位值；真实 .env / .env.staging / .env.prod **禁止**进入版本库
#   2. 所有服务共用这一份变量口径；staging 与 prod 的差异只是文件内容与项目名
#   3. POSTGRES_PASSWORD 会被拼进 DATABASE_URL，含 @ : / % # ? & 等字符时必须做
#      URL 编码（例如 @ → %40），或直接使用 URL 安全字符集
#   4. 生成强密码：openssl rand -base64 24 | tr -d '/+=' （或 openssl rand -hex 24）

# ---------------------------------------------------------------------------
# 项目标识（同一台机器上 staging 与 prod 靠它隔离容器/卷/网络，务必区分）
# ---------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=exam-staging
# 运行环境：staging / prod（影响 SESSION_COOKIE_SECURE 默认语义与日志标注）
APP_ENV=staging
APP_VERSION=1.0.0
# 镜像 tag：回滚时改为上一个已知good tag（如 1.0.0-rc1、commit SHA）
IMAGE_TAG=local
# 注：容器内不做时区转换，日志/备份时间戳统一使用 UTC（backup.sh 用 date -u）

# ---------------------------------------------------------------------------
# PostgreSQL（postgres 服务初始化 + api/backup 连接凭据）
# ---------------------------------------------------------------------------
POSTGRES_DB=exam
POSTGRES_USER=exam
# 占位值：首次部署必须替换；`docker compose config` 不会拦截弱口令
POSTGRES_PASSWORD=CHANGE_ME_use_openssl_rand_hex_24

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
# 服务端会话有效期（契约固定 8h，非必要不要改）
SESSION_TTL_HOURS=8
# Cookie Secure 标志（ADR-004）：
#   - TLS/HTTPS（prod 必须）：true
#   - staging 用纯 HTTP 冒烟时临时改 false，否则 http 客户端不会回传 Cookie，
#     表现为“登录 200 但随后 401”；冒烟结束/接入 TLS 后必须改回 true
SESSION_COOKIE_SECURE=true
# 容器启动时自动 alembic upgrade head；排障或手工控库时可临时 false
RUN_MIGRATIONS=true
API_PREFIX=/api
# 仅信任 edge 网络内的 nginx 转发头（api 不发布端口）；如改为固定网段更严格
FORWARDED_ALLOW_IPS=*

# ---------------------------------------------------------------------------
# API 并发容量（100 并发学生的实测口径，见 docs/61 §10.2）
# ---------------------------------------------------------------------------
# uvicorn worker 数：1 个进程只能吃满 1 核，100+100 VU 时 p95 必然超 300ms；
# 4 worker 实测 session_read p95 ≈ 82ms。默认 4，按机器核数上调。
WEB_CONCURRENCY=4
# 每 worker 的 SQLAlchemy 连接池（必须满足 WEB_CONCURRENCY × (SIZE + OVERFLOW) < 100）
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10

# ---------------------------------------------------------------------------
# Nginx
# ---------------------------------------------------------------------------
# 宿主监听端口（对外）。80/443 被占用时用 8080 等高位端口先验证
NGINX_HTTP_PORT=8080
# TLS 启用后再打开（同时需在 compose 中取消 443 映射注释）
# NGINX_HTTPS_PORT=8443

# ---------------------------------------------------------------------------
# 备份（完整策略由 TASK-REL-002 扩展）
# ---------------------------------------------------------------------------
# 保留天数：超过该天数的 *.dump 会在每次成功备份后被清理
BACKUP_RETENTION_DAYS=7
# 备份间隔（秒）：86400 = 每日一次；演练时可临时改 300 观察
BACKUP_INTERVAL_SECONDS=86400
